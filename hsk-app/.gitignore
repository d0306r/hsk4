# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 의존성
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 빌드 결과물
.next/
out/
build
dist
*.tsbuildinfo

# 환경 변수 (🔴 절대 올리면 안 됨!)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# 디버그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 에디터
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db